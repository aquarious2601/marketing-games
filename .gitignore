# Dependencies
/*/backend/vendor/
/*/frontend/node_modules/

# Test artefacts
/*/backend/.phpunit.cache/
/*/frontend/coverage/
/*/frontend/test-results/
/*/frontend/playwright-report/
/*/frontend/blob-report/
/*/frontend/.playwright/
*.tsbuildinfo

# Build output
/*/frontend/dist/
/*/backend/var/
/*/backend/public/bundles/
# Dumped by FrameworkBundle on every debug container rebuild, for IDEs and
# static analysis only: nothing in the app reads it and prod never writes it.
# Tracked, it made each cache warm-up look like a change.
/*/backend/config/reference.php

# Environment & secrets
.env.local
.env.*.local
/*/backend/.env.local
/*/backend/.env.*.local
/*/backend/config/jwt/

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Logs
*.log
